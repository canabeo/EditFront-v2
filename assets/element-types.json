{
  "version": 1,
  "actionCatalog": [
    "editText",
    "textSize",
    "align",
    "link",
    "imageSrc",
    "imageAlt",
    "insertAfter",
    "duplicate",
    "moveUp",
    "moveDown",
    "delete",
    "advanced",
    "background"
  ],
  "types": [
    {
      "key": "heading",
      "label": "Заголовок",
      "match": "h1,h2,h3,h4,h5,h6",
      "quickActions": [
        "editText",
        "align",
        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "paragraph",
      "label": "Абзац",
      "match": "p",
      "quickActions": [
        "editText",
        "align",
        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "button",
      "label": "Кнопка",
      "match": "button, a.btn, a[class*='button']",
      "quickActions": [
        "editText",
        "link",
        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "link",
      "label": "Ссылка",
      "match": "a",
      "quickActions": [
        "editText",
