    {
      "key": "generic",
      "label": "Блок",
      "match": "*",
      "quickActions": [
        "insertAfter",
        "duplicate",
        "moveUp",
        "moveDown",
        "delete"
      ],
      "more": [
        "align",
        "background",
        "advanced"
      ]
    }
