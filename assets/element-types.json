        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "image",
      "label": "Картинка",
      "match": "img",
      "quickActions": [
        "imageSrc",
        "imageAlt",
        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "list",
      "label": "Список",
      "match": "ul,ol",
      "quickActions": [
        "editText",
        "duplicate",
        "delete"
      ],
      "more": [
        "moveUp",
        "moveDown",
        "insertAfter",
        "background",
        "advanced"
      ]
    },
    {
      "key": "listItem",
