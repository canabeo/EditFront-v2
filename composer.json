{
    "name": "canabeo/editfront-v2",
    "description": "EditFront v2 — flat-file drop-in CMS for visual editing of existing static HTML sites",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "twig/twig": "^3.14",
        "masterminds/html5": "^2.9",
        "monolog/monolog": "^3.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": { "php": "8.2.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": { "EditFront\\": "app/src/" }
    },
    "autoload-dev": {
        "psr-4": { "EditFront\\Tests\\": "tests/" }
    }
}
