# EditFront v2 — environment. Copy to .env (the install wizard creates it for
# you when the folder is writable). Every value here is optional and has a
# sensible default; uncomment only what you need to change.

# URL prefix the CMS is reached at. Default /cms means the ZIP unpacks to a
# "cms" folder in your site root. If you rename the folder or install deeper,
# set this to match, e.g. /editor or /sub/cms.
#BASE_PATH=/cms

# Absolute path to the static site you edit. Default = the parent of this
# folder (the drop-in case). Set only if the site lives elsewhere.
#SITE_ROOT=/var/www/example.com

# Where backups/drafts/journal/uploads-meta live. Default = ./storage.
#STORAGE_DIR=/var/www/example.com/cms/storage

# Show stack traces (development only). NEVER on in production.
#APP_DEBUG=false

# Minimal-touch open: only stamp ids when opening a page, without reformatting
# the rest of the HTML. Keeps the original formatting closer; diffs a bit noisier.
#ANNOTATE_ONLY=false

# Pre-save snapshots kept per page (inode budget on cheap hosts).
#BACKUP_RETENTION=20

# Max upload size in bytes (default 10 MB). Keep <= php upload_max_filesize.
#UPLOAD_MAX_BYTES=10485760

# Origin used in sitemap.xml. Empty = derived from the request. Set to your
# real domain to be safe behind proxies, e.g. https://example.com
#SITE_BASE_URL=

# Auto-generated by the install wizard. Do not set by hand.
#APP_SECRET=

# Bootstrap admin (only used until the wizard writes storage/admin.json).
#ADMIN_USERNAME=
#ADMIN_PASSWORD_HASH=
